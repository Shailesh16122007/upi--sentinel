# Copy to backend/.env. All variables use the SENTINEL_ prefix.
SENTINEL_ENV=dev
# PostgreSQL (docker compose up -d postgres). Remove this line to use a local SQLite file instead.
SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:sentinel@127.0.0.1:5432/sentinel
SENTINEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SENTINEL_SESSION_HOURS=12
# Demo deployments only — set both to false in production
SENTINEL_SHOW_DEMO_ACCOUNTS=true
SENTINEL_SEED_DEMO=true
SENTINEL_MAX_UPLOAD_MB=15
SENTINEL_MAX_AUDIO_MB=40
SENTINEL_STT_ENGINE=faster-whisper
SENTINEL_WHISPER_MODEL=base
SENTINEL_OCR_LANG=auto
SENTINEL_ML_MIN_HISTORY=20
# Partner keys for the real-time risk API (X-API-Key) — not used by people signing in
SENTINEL_API_KEYS=demo-psp-key
# Optional: LLM rewrite of the investigator summary (structured findings only are sent)
# SENTINEL_ANTHROPIC_API_KEY=
