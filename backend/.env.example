# Copy to backend/.env. All variables use the SENTINEL_ prefix.
SENTINEL_ENV=dev
# SQLite default (no setup). For PostgreSQL:
# SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:sentinel@127.0.0.1:5432/sentinel
SENTINEL_API_KEYS=demo-psp-key
SENTINEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SENTINEL_MAX_UPLOAD_MB=15
SENTINEL_MAX_AUDIO_MB=40
SENTINEL_STT_ENGINE=faster-whisper
SENTINEL_WHISPER_MODEL=base
SENTINEL_OCR_LANG=eng
SENTINEL_ML_MIN_HISTORY=20
# Optional: LLM rewrite of the investigation summary (structured findings only are sent)
# SENTINEL_ANTHROPIC_API_KEY=
